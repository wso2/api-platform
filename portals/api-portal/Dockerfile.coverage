# API Portal coverage image — integration tests only, never released or shipped.
#
# Built on top of the release image (see Dockerfile), adding:
#   - the browser scripts (src/scripts) instrumented for coverage, and
#   - a writable /coverage folder for Node's V8 coverage output (NODE_V8_COVERAGE).
#
# Build it through docker-bake.coverage.hcl, which supplies the two named build
# contexts this file uses: "release" (the release image, built in the same run) and
# "coverage-scripts" (tests/framework/tools). `make build ENABLE_COVERAGE=true` does.

# Instrument the scripts taken from the release image itself, in a throwaway stage,
# so neither npm nor istanbul-lib-instrument ends up in the coverage image (the
# release image has npm removed). The instrumenter comes from the coverage-scripts
# build context and istanbul from a cache mount; neither lands in an image layer.
FROM node:24-alpine AS instrument
WORKDIR /work
COPY --from=release /app/src/scripts ./src/scripts
RUN --mount=type=bind,from=coverage-scripts,source=instrument-browser-coverage.js,target=/tmp/instrument-browser-coverage.js \
    --mount=type=cache,target=/tmp/coverage-npm-cache \
    npm install istanbul-lib-instrument@6.0.3 --no-save --prefix /tmp/coverage-npm-cache \
 && NODE_PATH=/tmp/coverage-npm-cache/node_modules node /tmp/instrument-browser-coverage.js src/scripts

FROM release
USER 0
COPY --from=instrument /work/src/scripts /app/src/scripts
RUN mkdir -p /coverage && chown 10001:0 /coverage && chmod g=u /coverage
USER 10001:10001
