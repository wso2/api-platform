      <!-- ══ Manage APIs ══ -->
      <div class="cfg-panel" id="cfg-apis">

        <!-- API list view -->
        <div id="cfg-apis-list">
          <div class="cfg-panel-header">
            <div>
              <h2 class="cfg-panel-title">Manage APIs</h2>
              <p class="cfg-panel-desc">Add, edit, and remove the APIs visible in this API Portal.</p>
            </div>
            <div style="display:flex; gap:10px;">
              <button class="cfg-btn-primary" id="cfg-add-api-btn" type="button">
                <i class="bi bi-plus"></i> Add API
              </button>
            </div>
          </div>

          <div class="cfg-bulk-bar" id="cfg-bulk-bar" style="display:none;" role="region" aria-label="Bulk actions">
            <span class="cfg-bulk-bar-count" id="cfg-bulk-bar-count"></span>
            <button type="button" class="cfg-btn-danger cfg-btn-sm" id="cfg-bulk-delete-btn">
              <i class="bi bi-trash"></i> Delete selected
            </button>
          </div>

          <div class="cfg-table-wrap">
            <table class="cfg-table">
              <thead>
                <tr>
                  <th class="cfg-th-check"><input type="checkbox" id="cfg-select-all" aria-label="Select all APIs"></th>
                  <th>API</th>
                  <th>Type</th>
                  <th>Version</th>
                  <th>Status</th>
                  <th style="width:52px;"></th>
                </tr>
              </thead>
              <tbody id="cfg-apis-tbody">
                {{#orgAPIs}}
                <tr id="cfg-api-row-{{apiId}}">
                  <td class="cfg-td-check">
                    <input type="checkbox" class="cfg-row-check"
                      data-id="{{apiId}}" data-name="{{apiName}}"
                      aria-label="Select {{apiName}}">
                  </td>
                  <td>
                    <div class="cfg-api-cell">
                      {{#if thumbnailUrl}}
                      <img class="cfg-api-avatar cfg-api-avatar--img" src="{{thumbnailUrl}}" alt="">
                      {{else}}
                      <span class="cfg-api-avatar
                        {{#if (eq apiType "GRAPHQL")}}cfg-api-avatar--graphql
                        {{else if (eq apiType "WS")}}cfg-api-avatar--ws
                        {{else if (eq apiType "SOAP")}}cfg-api-avatar--soap
                        {{else if (eq apiType "Mcp")}}cfg-api-avatar--mcp
                        {{else if (eq apiType "WebSubApi")}}cfg-api-avatar--websub
                        {{else}}cfg-api-avatar--rest{{/if}}">{{firstTwoLetters apiName}}</span>
                      {{/if}}
                      <div>
                        <div class="cfg-cell-name">{{apiName}}</div>
                        <div class="cfg-cell-context">/{{apiHandle}}</div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="cfg-type-badge
                      {{#if (eq apiType "GRAPHQL")}}cfg-type-badge--graphql
                      {{else if (eq apiType "WS")}}cfg-type-badge--ws
                      {{else if (eq apiType "SOAP")}}cfg-type-badge--soap
                      {{else if (eq apiType "Mcp")}}cfg-type-badge--mcp
                      {{else if (eq apiType "WebSubApi")}}cfg-type-badge--websub
                      {{else}}cfg-type-badge--rest{{/if}}">
                      {{#if (eq apiType "WS")}}WebSocket
                      {{else if (eq apiType "GRAPHQL")}}GraphQL
                      {{else if (eq apiType "SOAP")}}SOAP
                      {{else if (eq apiType "WebSubApi")}}WebSub
                      {{else if (eq apiType "Mcp")}}MCP
                      {{else}}REST{{/if}}
                    </span>
                  </td>
                  <td class="cfg-cell-version">{{apiVersion}}</td>
                  <td>
                    {{#if (eq apiStatus "PUBLISHED")}}
                    <span class="cfg-status-badge cfg-status-published">
                      <span class="cfg-status-dot"></span>Published
                    </span>
                    {{else if (eq apiStatus "DEPRECATED")}}
                    <span class="cfg-status-badge cfg-status-deprecated">
                      <span class="cfg-status-dot"></span>Deprecated
                    </span>
                    {{else}}
                    <span class="cfg-status-badge cfg-status-draft">
                      <span class="cfg-status-dot"></span>Draft
                    </span>
                    {{/if}}
                  </td>
                  <td class="cfg-cell-actions">
                    <button class="cfg-action-btn cfg-menu-trigger" type="button" aria-label="API actions">
                      <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <div class="cfg-dropdown">
                      <button class="cfg-dropdown-item cfg-edit-trigger" type="button" data-id="{{apiId}}">
                        <i class="bi bi-pencil"></i> Edit
                      </button>
                      {{#if (eq apiStatus "PUBLISHED")}}
                      <button class="cfg-dropdown-item cfg-unpublish-trigger" type="button" data-id="{{apiId}}" data-name="{{apiName}}">
                        <i class="bi bi-archive"></i> Deprecate
                      </button>
                      {{else}}
                      <button class="cfg-dropdown-item cfg-publish-trigger" type="button" data-id="{{apiId}}" data-name="{{apiName}}">
                        <i class="bi bi-cloud-upload"></i> Publish
                      </button>
                      {{/if}}
                      <div class="cfg-dropdown-divider"></div>
                      <button class="cfg-dropdown-item cfg-dropdown-item--danger cfg-delete-trigger" type="button"
                        data-id="{{apiId}}" data-name="{{apiName}}">
                        <i class="bi bi-trash"></i> Delete
                      </button>
                    </div>
                  </td>
                </tr>
                {{/orgAPIs}}
                {{#unless orgAPIs.length}}
                <tr><td colspan="6" class="cfg-empty-row">No APIs found. Click <strong>Add API</strong> to get started.</td></tr>
                {{/unless}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- API wizard -->
        <div id="cfg-apis-wizard" style="display:none;">
          <a href="#" class="cfg-wizard-back" id="cfg-wizard-back-link">
            <i class="bi bi-arrow-left"></i> Back to Manage APIs
          </a>
          <h2 class="cfg-panel-title" id="cfg-wizard-title" style="margin:14px 0 0;">Create API</h2>
          <p class="cfg-wizard-subtitle" id="cfg-wizard-subtitle"></p>

          <!-- Stepper -->
          <div class="cfg-stepper">
            <div class="cfg-step cfg-step--active" data-step="0">
              <span class="cfg-step-circle">1</span><span class="cfg-step-label">Details</span>
            </div>
            <div class="cfg-step-connector"></div>
            <div class="cfg-step" data-step="1">
              <span class="cfg-step-circle">2</span><span class="cfg-step-label">Spec</span>
            </div>
            <div class="cfg-step-connector"></div>
            <div class="cfg-step" data-step="2">
              <span class="cfg-step-circle">3</span><span class="cfg-step-label">Assets</span>
            </div>
          </div>

          <!-- Step 0: Details -->
          <div class="cfg-wizard-step" id="cfg-wstep-0" style="max-width:720px;">
            <section class="cfg-form-card" id="wz-card-general">
              <div class="cfg-form-card-head">
                <h3 class="cfg-form-card-title">General</h3>
                <p class="cfg-form-card-desc">How this <span class="wz-noun">API</span> is named and shown in the portal.</p>
              </div>
              <div class="cfg-form-grid">
                <div class="cfg-form-group cfg-form-group-full">
                  <label for="wz-thumb-input">Thumbnail</label>
                  <div class="cfg-thumb-row" id="wz-thumb-row">
                    <span class="cfg-thumb-preview" id="wz-thumb-preview"></span>
                    <span class="cfg-thumb-info">
                      <span class="cfg-thumb-name" id="wz-thumb-name"></span>
                      <span class="cfg-field-hint" id="wz-thumb-hint">PNG or JPG</span>
                    </span>
                    <span class="cfg-docs-tag" id="wz-thumb-tag" hidden></span>
                    <button type="button" class="cfg-docs-undo" id="wz-thumb-undo" hidden>Undo</button>
                    <label class="cfg-action-btn" id="wz-thumb-replace" title="Replace thumbnail" aria-label="Replace thumbnail">
                      <i class="bi bi-upload"></i>
                      <input type="file" id="wz-thumb-input" accept=".png,.jpg,.jpeg" hidden />
                    </label>
                    <button type="button" class="cfg-action-btn" id="wz-thumb-remove" title="Remove thumbnail" aria-label="Remove thumbnail">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                  <p id="wz-thumb-error" class="cfg-assets-error" role="alert" style="display:none;"></p>
                </div>
                <div class="cfg-form-group">
                  <label for="wz-name">Name <span class="required">*</span></label>
                  <input type="text" id="wz-name" class="cfg-form-input" placeholder="e.g. Reading-List-API" />
                  <p id="wz-name-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
                <div class="cfg-form-group">
                  <label for="wz-version">Version <span class="required">*</span></label>
                  <input type="text" id="wz-version" class="cfg-form-input" placeholder="e.g. v1.0" />
                  <p id="wz-version-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
                <div class="cfg-form-group">
                  <label for="wz-handle">Handle (URL slug) <span class="required">*</span></label>
                  <input type="text" id="wz-handle" class="cfg-form-input cfg-form-input--mono" placeholder="reading-list-api-v1.0" />
                  <p class="cfg-field-hint">Auto-generated from name &amp; version. Edit to override — cannot be changed once created.</p>
                  <p id="wz-handle-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
                <div class="cfg-form-group" id="wz-type-group">
                  <label for="wz-type">API type <span class="required">*</span></label>
                  <select id="wz-type" class="cfg-form-input">
                    <option value="" disabled>Select a type</option>
                    <option value="RestApi">REST</option>
                    <option value="WS">WebSocket</option>
                    <option value="GRAPHQL">GraphQL</option>
                  </select>
                  <p id="wz-type-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
                <div class="cfg-form-group">
                  <label>Agent visibility</label>
                  <div class="cfg-vis-toggle">
                    <button type="button" class="cfg-vis-btn active" id="wz-vis-visible" data-val="Visible">
                      <i class="bi bi-eye"></i> Visible
                    </button>
                    <button type="button" class="cfg-vis-btn" id="wz-vis-hidden" data-val="Hidden">
                      <i class="bi bi-eye-slash"></i> Hidden
                    </button>
                  </div>
                </div>
                <div class="cfg-form-group">
                  <label for="wz-status">Status</label>
                  <select id="wz-status" class="cfg-form-input">
                    <option value="PUBLISHED">Published</option>
                    <option value="DEPRECATED">Deprecated</option>
                  </select>
                </div>
                <div class="cfg-form-group cfg-form-group-full">
                  <label for="wz-desc">Description</label>
                  <textarea id="wz-desc" class="cfg-form-input" rows="3" placeholder="Describe what this API does in 1–2 sentences…"></textarea>
                  <p id="wz-desc-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
              </div>
            </section>
            <section class="cfg-form-card" id="wz-card-endpoints">
              <div class="cfg-form-card-head">
                <h3 class="cfg-form-card-title">Endpoints</h3>
                <p class="cfg-form-card-desc">Where consumers send requests.</p>
              </div>
              <div class="cfg-form-grid">
                <div class="cfg-form-group">
                  <label for="wz-prod">Production URL</label>
                  <input type="text" id="wz-prod" class="cfg-form-input cfg-form-input--mono" placeholder="https://api.example.com/booking" />
                  <p id="wz-prod-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
                <div class="cfg-form-group">
                  <label for="wz-sandbox">Sandbox URL</label>
                  <input type="text" id="wz-sandbox" class="cfg-form-input cfg-form-input--mono" placeholder="https://sandbox.example.com/booking" />
                  <p id="wz-sandbox-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
              </div>
            </section>
            <section class="cfg-form-card" id="wz-card-labels">
              <div class="cfg-form-card-head">
                <h3 class="cfg-form-card-title">Labels and tags</h3>
                <p class="cfg-form-card-desc">Labels decide which views list this <span class="wz-noun">API</span>. Tags help people find it in search.</p>
              </div>
              <div class="cfg-form-grid">
                <div class="cfg-form-group cfg-form-group-full">
                  <label>Labels</label>
                  {{#if orgLabels.length}}
                  <div id="wz-labels" class="cfg-label-picker" role="group" aria-label="API labels">
                    {{#orgLabels}}
                    <button type="button" class="cfg-label-toggle" data-value="{{id}}" aria-pressed="false">
                      <i class="bi bi-check2"></i><span>{{displayName}}</span>
                    </button>
                    {{/orgLabels}}
                  </div>
                  <p class="cfg-field-hint">Click labels to toggle. Labels control which views this API appears in.</p>
                  {{else}}
                  <p class="cfg-field-hint">No labels yet — create them in the Labels tab to attach them here.</p>
                  {{/if}}
                </div>
                <div class="cfg-form-group cfg-form-group-full">
                  <label for="wz-tags-input">Tags</label>
                  {{!-- Chip input, same markup/classes as the subscription-plan picker
                        above. Tags are free text, so there is no dropdown — a chip is
                        committed from what was typed. --}}
                  <div class="cfg-chip-input-wrap" id="wz-tags-wrap">
                    <div id="wz-tags-chips" style="display:contents;"></div>
                    <input type="text" class="cfg-chip-text-input" id="wz-tags-input"
                      placeholder="Add a tag…" autocomplete="off" aria-describedby="wz-tags-hint" />
                  </div>
                  <p class="cfg-field-hint" id="wz-tags-hint">Free-text keywords for search and discovery. Press Enter or comma to add; Backspace removes the last tag.</p>
                </div>
              </div>
            </section>
            <section class="cfg-form-card" id="wz-card-ownership">
              <div class="cfg-form-card-head">
                <h3 class="cfg-form-card-title">Ownership</h3>
                <p class="cfg-form-card-desc">Who consumers can contact about this <span class="wz-noun">API</span>.</p>
              </div>
              <div class="cfg-form-grid">
                <div class="cfg-form-group">
                  <label for="wz-tech-owner">Technical owner</label>
                  <input type="text" id="wz-tech-owner" class="cfg-form-input" placeholder="e.g. John Doe" />
                </div>
                <div class="cfg-form-group">
                  <label for="wz-tech-email">Technical owner email</label>
                  <input type="text" id="wz-tech-email" class="cfg-form-input cfg-form-input--mono" placeholder="john.doe@example.com" />
                  <p id="wz-tech-email-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
                <div class="cfg-form-group">
                  <label for="wz-biz-owner">Business owner</label>
                  <input type="text" id="wz-biz-owner" class="cfg-form-input" placeholder="e.g. Jane Doe" />
                </div>
                <div class="cfg-form-group">
                  <label for="wz-biz-email">Business owner email</label>
                  <input type="text" id="wz-biz-email" class="cfg-form-input cfg-form-input--mono" placeholder="jane.doe@example.com" />
                  <p id="wz-biz-email-error" style="display:none;color:#c62828;font-size:.75rem;margin:3px 0 0;"></p>
                </div>
              </div>
            </section>
            <section class="cfg-form-card" id="wz-card-plans">
              <div class="cfg-form-card-head">
                <h3 class="cfg-form-card-title">Subscription plans</h3>
                <p class="cfg-form-card-desc">Plans consumers can choose when they subscribe to this <span class="wz-noun">API</span>.</p>
              </div>
              <div class="cfg-form-group cfg-form-group-full" style="position:relative;">
                <label>Subscription plans</label>
                <div class="cfg-chip-input-wrap" id="wz-policy-chip-wrap">
                  <div id="wz-policy-chips" style="display:contents;"></div>
                  <input type="text" class="cfg-chip-text-input" id="wz-policy-search"
                    placeholder="{{#if orgPlans.length}}Type to search plans…{{else}}No plans available{{/if}}"
                    autocomplete="off" {{#unless orgPlans.length}}disabled{{/unless}} />
                </div>
                <div class="cfg-chip-dropdown" id="wz-policy-dropdown"></div>
                {{#unless orgPlans.length}}
                <p style="font-size:.844rem;color:#9aa3af;margin:6px 0 0;">No subscription plans yet. Create them under <strong>Subscription Plans</strong>.</p>
                {{/unless}}
              </div>
            </section>
          </div>

          <!-- Step 1: Spec -->
          <div class="cfg-wizard-step" id="cfg-wstep-1" style="display:none;">
            <p class="cfg-wstep-desc" id="wz-spec-desc"></p>
            <div class="cfg-spec-current" id="wz-spec-onfile" style="display:none;">
              <span class="cfg-spec-icon"><i class="bi bi-file-earmark-check"></i></span>
              <div>
                <div class="cfg-spec-name" id="wz-spec-current-title">Current spec</div>
                <div class="cfg-spec-sub" id="wz-spec-current-sub">On file for this API</div>
              </div>
              <span class="cfg-docs-tag" id="wz-spec-replaced-tag" hidden>Will be replaced</span>
            </div>
            <div class="cfg-spec-chip" id="wz-spec-chip">
              <span class="cfg-spec-icon"><i class="bi bi-file-check"></i></span>
              <div>
                <div class="cfg-spec-name" id="wz-spec-name"></div>
                <div class="cfg-spec-sub" id="wz-spec-sub"></div>
              </div>
              <button type="button" class="cfg-action-btn" id="wz-spec-remove" style="margin-left:auto;" title="Remove" aria-label="Remove">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <label class="cfg-upload-zone" id="wz-spec-zone">
              <span class="cfg-upload-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
              <span class="cfg-upload-label">Drag &amp; drop or <span>browse</span> to upload</span>
              <span class="cfg-upload-hint">One file · up to 10 MB</span>
              <input type="file" id="wz-spec-input" accept=".json,.yaml,.yml,.graphql,.gql,.wsdl,.xml" />
            </label>
            <p id="wz-spec-error" style="display:none;color:#c62828;font-size:.813rem;margin:8px 0 0;">A spec file is required to continue.</p>
            <div class="cfg-spec-formats" id="wz-spec-formats">
              <p class="cfg-assets-heading">Accepted formats</p>
              <table>
                <tbody>
                  <tr><td>OpenAPI</td><td><code>.json</code> <code>.yaml</code></td></tr>
                  <tr><td>AsyncAPI</td><td><code>.json</code> <code>.yaml</code></td></tr>
                  <tr><td>GraphQL SDL</td><td><code>.graphql</code></td></tr>
                  <tr><td>WSDL</td><td><code>.wsdl</code> <code>.xml</code></td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Step 2: Assets -->
          <div class="cfg-wizard-step" id="cfg-wstep-2" style="display:none;">
            <div class="cfg-assets-panel" id="wz-assets-panel-docs">
              <p class="cfg-wstep-desc" id="wz-assets-desc-docs" hidden>Add documents for this <span class="wz-noun">API</span>. You can change them later by editing the <span class="wz-noun">API</span>.</p>
              <label class="cfg-upload-compact" id="wz-docs-zone">
                <i class="bi bi-upload" style="color:#0277bd;font-size:1rem;flex:none;"></i>
                <span style="font-size:.844rem;font-weight:600;color:#1a2433;">Drag &amp; drop or <span style="color:#1f6feb;">browse</span> to upload <span style="color:#9aa3af;font-weight:400;">— multiple files</span></span>
                <input type="file" id="wz-docs-input" multiple />
              </label>
              <div id="wz-existing-docs-section" hidden>
                <p class="cfg-assets-heading">On this <span class="wz-noun">API</span></p>
                <div id="wz-existing-docs-list" class="cfg-docs-list"></div>
              </div>
              <div id="wz-new-docs-section" hidden>
                <p class="cfg-assets-heading">To upload</p>
                <div id="wz-docs-list" class="cfg-docs-list"></div>
              </div>
              <p class="cfg-assets-summary" id="wz-docs-summary" aria-live="polite"></p>
              <button type="button" class="cfg-link-btn" id="wz-assets-to-import">
                <i class="bi bi-file-earmark-zip"></i> Import content from ZIP
              </button>
            </div>

            <div class="cfg-assets-panel" id="wz-assets-panel-import" hidden>
              <p id="wz-content-error" class="cfg-assets-alert" role="alert" style="display:none;"></p>
              <button type="button" class="cfg-link-btn" id="wz-assets-to-docs">
                <i class="bi bi-arrow-left"></i> Back to uploading documents
              </button>
              <p class="cfg-assets-title">Import a content package</p>
              <p class="cfg-wstep-desc" id="wz-assets-desc-import" hidden>Saving removes the current documents, landing page and thumbnail, and uses this ZIP’s content instead.</p>
              <div class="cfg-assets-layout">
                <p class="cfg-assets-heading">Expected ZIP layout</p>
                <table>
                  <tbody>
                    <tr><td><code>web/</code></td><td></td></tr>
                    <tr><td class="cfg-assets-layout-nested"><code>apiContent.md</code> or <code>.hbs</code></td><td>Landing page</td></tr>
                    <tr><td class="cfg-assets-layout-nested"><code>api-icon.png</code> or <code>.jpg</code></td><td>Thumbnail</td></tr>
                    <tr><td class="cfg-assets-layout-nested">other images</td><td>Used by the landing page</td></tr>
                    <tr><td><code>docs/</code></td><td></td></tr>
                    <tr><td class="cfg-assets-layout-nested"><code>&lt;file&gt;</code></td><td>Document, category Other</td></tr>
                    <tr><td class="cfg-assets-layout-nested"><code>&lt;Category&gt;/&lt;file&gt;</code></td><td>Document in that category</td></tr>
                  </tbody>
                </table>
              </div>
              <label class="cfg-upload-zone" id="wz-content-zone">
                <span class="cfg-upload-icon"><i class="bi bi-file-earmark-zip"></i></span>
                <span class="cfg-upload-label">Drag &amp; drop or <span>browse</span> to upload</span>
                <span class="cfg-upload-hint">One .zip file · up to 10 MB</span>
                <input type="file" id="wz-content-input" accept=".zip" />
              </label>
              <div class="cfg-spec-chip" id="wz-content-chip">
                <span class="cfg-spec-icon"><i class="bi bi-file-earmark-zip-fill"></i></span>
                <div>
                  <div class="cfg-spec-name" id="wz-content-name"></div>
                  <div class="cfg-spec-sub" id="wz-content-sub"></div>
                </div>
                <button type="button" class="cfg-link-btn" id="wz-content-choose" style="margin-left:auto;" hidden>Choose another file</button>
                <button type="button" class="cfg-action-btn" id="wz-content-remove" style="margin-left:auto;" title="Remove" aria-label="Remove">
                  <i class="bi bi-x-lg"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Wizard actions -->
          <div class="cfg-wizard-actions">
            <div class="cfg-wizard-actions-right">
              <button type="button" class="cfg-btn-ghost" id="cfg-wizard-cancel">Cancel</button>
              <button type="button" class="cfg-btn-ghost" id="cfg-wizard-back-step" style="display:none;">Back</button>
              <button type="button" class="cfg-btn-primary" id="cfg-wizard-next">Next</button>
            </div>
          </div>
        </div>

      </div><!-- /#cfg-apis -->
