      <!-- ══ Subscription Plans ══ -->
      <div class="cfg-panel" id="cfg-plans">
        <!-- Two sibling views, one visible at a time (see plan-editor.js): the list below, and the
             add/edit form in cfg-plan-form-view. Deleting still uses a modal, as elsewhere in settings. -->
        <div id="pln-list-view">
        <div class="cfg-panel-header">
          <div>
            <h2 class="cfg-panel-title">Subscription Plans</h2>
            <p class="cfg-panel-desc">Define the plans subscribers can choose, each with its conditions and price.</p>
          </div>
          <button class="cfg-btn-primary" id="cfg-add-plan-btn" type="button">
            <i class="bi bi-plus"></i> Add plan
          </button>
        </div>

        <div class="cfg-table-wrap">
          <table class="cfg-table cfg-plans-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Conditions</th>
                <th>Pricing</th>
                <th style="width:90px;"></th>
              </tr>
            </thead>
            <tbody id="cfg-plans-tbody">
              {{#orgPlans}}
              <tr id="cfg-plan-row-{{planId}}"
                data-id="{{planId}}"
                data-name="{{planName}}"
                data-display="{{displayName}}"
                data-desc="{{description}}"
                data-conditions="{{{jsonAttr conditions}}}"
                data-pricing="{{{jsonAttr pricing}}}"
                data-refid="{{refId}}">
                <td>
                  <div class="cfg-plan-name">{{displayName}}</div>
                  {{!-- One line; settings-plans.js adds the full text as a hover title only when it is cut. --}}
                  {{#if description}}<div class="cfg-plan-desc">{{description}}</div>{{/if}}
                </td>
                <td>
                  {{#if conditionChips.length}}
                  <div class="cfg-cond-chips">
                    {{#conditionChips}}
                    {{!-- One chip per limit window; the chip shows it all, so no hover card. --}}
                    <span class="cfg-cond-chip" data-tip-title="{{tip.title}}" data-tip-details="{{tip.details}}">
                      <span class="cfg-cond-chip-name">{{label}}</span>
                      <span class="cfg-cond-chip-value">{{first}}</span>
                    </span>
                    {{/conditionChips}}
                    {{#if moreConditions.length}}
                    {{!-- Only "+N" has a hover card: the chips it hides, one per line. --}}
                    <span class="cfg-cond-chip cfg-cond-chip--more" tabindex="0" aria-label="{{moreConditions.length}} more conditions">
                      <span class="cfg-cond-chip-more">+{{moreConditions.length}}</span>
                      <span class="cfg-cond-tip" role="tooltip">
                        {{#moreConditions}}
                        <span class="cfg-cond-tip-row"><span class="cfg-cond-tip-title">{{title}}</span><span class="cfg-cond-tip-line">{{details}}</span></span>
                        {{/moreConditions}}
                      </span>
                    </span>
                    {{/if}}
                  </div>
                  {{else}}
                    <span style="color:#9aa3af;font-size:.8rem;">Unlimited</span>
                  {{/if}}
                </td>
                <td>
                  {{#if pricing}}
                    <span style="font-size:.8125rem;color:#1a2433;">{{pricingText}}</span>
                  {{else}}
                    <span style="color:#9aa3af;font-size:.8rem;">{{pricingText}}</span>
                  {{/if}}
                </td>
                <td>
                  <div class="cfg-row-actions">
                    <button class="cfg-icon-btn cfg-plan-edit-btn" type="button" data-id="{{planId}}"
                      title="Edit" aria-label="Edit {{displayName}}">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="cfg-icon-btn cfg-icon-btn--danger cfg-plan-delete-btn" type="button"
                      data-id="{{planId}}" data-name="{{planName}}" data-display="{{displayName}}"
                      data-apis="{{apiCount}}" data-subscriptions="{{subscriptionCount}}" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
              {{/orgPlans}}
              {{#unless orgPlans.length}}
              <tr><td colspan="4" class="cfg-tbl-empty">No subscription plans yet. Add one to get started.</td></tr>
              {{/unless}}
            </tbody>
          </table>
        </div>
        </div><!-- /#pln-list-view -->
{{> cfg-plan-form-view}}
      </div><!-- /#cfg-plans -->
