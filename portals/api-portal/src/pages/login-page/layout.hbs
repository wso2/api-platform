<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>API Portal &amp; MCP Hub — Sign In</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="{{basePath}}/images/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="{{basePath}}/styles/main.css">
  <link rel="stylesheet" href="{{basePath}}/styles/auth-shell.css">
  <link rel="stylesheet" href="{{basePath}}/styles/login.css">
  <script src="{{basePath}}/technical-scripts/signin.js" defer></script>
</head>
<body>

<div class="auth-root">

  <!-- ── LEFT: brand panel ─────────────────────────────────── -->
  <div class="auth-brand">
    <!-- Logo -->
    <div class="auth-logo-row">
      <img class="auth-logo-svg" src="{{basePath}}/images/api-portal-logo-white.svg" alt="API Portal &amp; MCP Hub" />
    </div>

    <!-- Hero copy -->
    <div class="auth-brand-body">
      <span class="auth-tenant-pill">Unified portal for APIs &amp; MCP</span>
      <h1 class="auth-headline">Discover, integrate, and ship faster.</h1>
      <p class="auth-desc">One place to explore published APIs and MCP servers, try them live, and manage your subscriptions and keys.</p>

      <div class="ln-features">
        <div class="ln-feature-item">
          <span class="ln-feature-icon"><i class="bi bi-compass"></i></span>
          <span class="ln-feature-text">Discover and explore published APIs and MCP servers</span>
        </div>
        <div class="ln-feature-item">
          <span class="ln-feature-icon"><i class="bi bi-terminal"></i></span>
          <span class="ln-feature-text">Try out APIs live with interactive consoles</span>
        </div>
        <div class="ln-feature-item">
          <span class="ln-feature-icon"><i class="bi bi-key"></i></span>
          <span class="ln-feature-text">Subscribe, then manage your access keys and tokens</span>
        </div>
      </div>
    </div>

    <!-- Desktop footer -->
    <div class="auth-foot-desktop">
      <span id="ln-year"></span>
      <a href="#">Privacy</a>
      <a href="#">Terms</a>
    </div>
  </div>

  <!-- ── RIGHT: sign-in form ───────────────────────────────── -->
  <div class="auth-form">
    <div class="auth-form-inner ln-form-inner">
      {{{body}}}
    </div>
  </div>

  <!-- Mobile footer -->
  <div class="auth-foot-mobile">
    <span id="ln-year-m"></span>
    <a href="#">Privacy</a>
    <a href="#">Terms</a>
  </div>

</div>

<script>
  (function () {
    var y = new Date().getFullYear();
    ['ln-year', 'ln-year-m'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.textContent = '© ' + y + ' WSO2';
    });
  })();
</script>

</body>
</html>
