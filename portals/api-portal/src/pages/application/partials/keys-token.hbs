{{!-- One modal per key manager per key type. Every id here therefore carries the key
      manager handle ({{../id}}) as well as the key type: keyed on {{keyType}} alone,
      a second key manager would emit a duplicate id and generateOauthKey would write
      the token into the clicked card's modal while opening the first card's. --}}
{{#each keyManagersMetadata}}
{{#if enabled}}
{{#each applicationKeys}}
<div class="modal custom-modal" id='keysTokenModal-{{../id}}-{{keyType}}'>
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content custom-modal-content">
            <div class="custom-modal-header">
                <h2 class="custom-modal-title m-0">Access Token ({{keyType}})</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-cyid="keysTokenModal-{{../id}}-{{keyType}}-close"
                    aria-label="Close" onclick="closeModal('keysTokenModal-{{../id}}-{{keyType}}')"></button>
            </div>
            <div class="custom-modal-body">
                <div class="container">
                    <div id="regenerateKeyBtn-{{../id}}-{{keyType}}" class="d-flex">
                        <div class="row">
                            <div id="tokenDisplay_{{../id}}_{{keyType}}" style="display: none;">
                                <div class="info-title pb-2">Request Permissions (Scopes)</div>
                                {{!-- modalScopeContainer, not scopeContainer: the KM card
                                      carries a scopeContainer with the same app/km/type
                                      suffix, and that is the one generateOauthKey resolves
                                      by id. This one is only ever read by traversal from
                                      the modal element (uiScopeChips), so giving it a
                                      distinct id keeps the page free of duplicate ids. --}}
                                <div class="input-scopes" id="modalScopeContainer-{{@root.applicationMetadata.id}}-{{../id}}-{{keyType}}"
                                    data-scopes="{{json @root.subscriptionScopes}}">
                                    <input type="text" class="text-input" id="modalScope-{{@root.applicationMetadata.id}}-{{../id}}-{{keyType}}"
                                        placeholder="Type scope and press Enter...">
                                </div>
                                <div class="alert alert-warning d-flex align-items-center mt-4" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <div>
                                        <strong>Important:</strong> This access token is displayed only once and cannot be retrieved later. Please copy and store it securely before closing this dialog.
                                    </div>
                                </div>
                                <div class="token-card">
                                    <pre id="token_{{../id}}_{{keyType}}" class="token-text"></pre>
                                    <button id="copyButton_{{../id}}_{{keyType}}" class="copy-button copy-btn" aria-label="Copy token"
                                        type="button" onclick="copyToken(this, '{{../id}}_{{keyType}}')">
                                        <span class="copy-btn-icon"><i class="bi bi-copy"></i></span>
                                        <span class="copy-btn-check"><i class="bi bi-check"></i> Copied</span>
                                    </button>
                                </div>
                                <div class="info-title pt-2 pb-2" id="resScopeTitle-{{../id}}-{{keyType}}">Response Permissions (Scopes)
                                </div>
                                <div id="responseScopeContainer-{{@root.applicationMetadata.id}}-{{../id}}-{{keyType}}"
                                    data-response-scopes="">
                                </div>
                                <div class="d-flex justify-content-end mt-4 mb-3"
                                    id="applicationKeyUpdateButtonContainer-{{../id}}-{{keyType}}">
                                    <button
                                        class="common-btn-primary btn-sm me-1"
                                        id="regenerateButton_{{../id}}_{{keyType}}"
                                        data-open-token-modal="true"
                                        data-form-id="inlineTokenForm-{{../id}}-{{keyType}}"
                                        data-app-id="{{@root.applicationMetadata.id}}"
                                        data-key-mapping-id="{{keys.keyMappingId}}"
                                        data-key-manager="{{../id}}"
                                        data-client-name="{{@root.applicationMetadata.displayName}}"
                                        data-scopes="{{json @root.subscriptionScopes}}"
                                        data-key-type="{{keyType}}">
                                        <span class="button-normal-state">
                                            <i class="bi bi-arrow-clockwise"></i> Regenerate
                                        </span>
                                        <span class="button-loading-state" style="display: none;">
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            Regenerating...
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/each}}
{{/if}}
{{/each}}
