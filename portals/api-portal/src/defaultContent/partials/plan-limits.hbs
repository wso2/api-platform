{{!-- A plan card's description and every limit of its conditions, as the admin's plan preview shows
      them. plan-checkout.js reads the limits for the subscribe dialog. --}}
{{#if description}}<p class="aov-plan-desc">{{description}}</p>{{/if}}
<ul class="aov-plan-limit aov-plan-limits">
  {{#each limitLines}}
  <li>{{text}}{{#if allow}} <span class="aov-plan-overage">overage allowed</span>{{/if}}</li>
  {{else}}
  <li class="aov-plan-unlimited">Unlimited</li>
  {{/each}}
</ul>
