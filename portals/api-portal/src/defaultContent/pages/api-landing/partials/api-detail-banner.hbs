<div class="aov-hero">
  <div class="aov-hero-top">
    <div class="aov-hero-thumb">
      {{#if apiMetadata.apiImageMetadata.api-icon}}
      <img class="aov-api-img" src="{{apiMetadata.apiImageMetadata.api-icon}}" alt="{{apiMetadata.name}}" />
      {{else}}
      <div class="aov-api-avatar">{{firstTwoLetters apiMetadata.name}}</div>
      {{/if}}
    </div>
    <div class="aov-hero-title-row">
      <h1 class="aov-hero-name">{{apiMetadata.name}}</h1>
      <div class="aov-hero-badges">
        {{#if apiMetadata.version}}
        <span class="dp-badge dp-badge--version">{{apiMetadata.version}}</span>
        {{/if}}
        {{#if apiMetadata.type}}
        <span class="dp-badge
          {{#if (eq apiMetadata.type "GRAPHQL")}}dp-badge--graphql
          {{else if (eq apiMetadata.type "WS")}}dp-badge--ws
          {{else if (eq apiMetadata.type "SOAP")}}dp-badge--soap
          {{else if (eq apiMetadata.type "WebSubApi")}}dp-badge--ws
          {{else}}dp-badge--rest{{/if}}">
          {{#if (eq apiMetadata.type "GRAPHQL")}}<img src="{{basePath}}/images/graphql-icon.svg" class="dp-badge-icon" alt="" /> GraphQL
          {{else if (eq apiMetadata.type "WS")}}<img src="{{basePath}}/images/websocket-icon.svg" class="dp-badge-icon" alt="" /> WebSocket
          {{else if (eq apiMetadata.type "WebSubApi")}}<i class="bi bi-broadcast-pin"></i> WebSub
          {{else if (eq apiMetadata.type "SOAP")}}<i class="bi bi-file-code"></i> SOAP
          {{else}}<i class="bi bi-braces"></i> REST{{/if}}
        </span>
        {{/if}}
        {{#if aiEnabled}}
        {{#unless (eq apiMetadata.agentVisibility "HIDDEN")}}
        <span class="dp-badge dp-badge--ai" title="AI agents can discover and use this API">
          <i class="bi bi-robot"></i> AI Ready
        </span>
        {{/unless}}
        {{/if}}
        {{#if (eq apiMetadata.status "DEPRECATED")}}
        <span class="dp-badge dp-badge--deprecated"><i class="bi bi-exclamation-circle"></i> Deprecated</span>
        {{/if}}
      </div>
    </div>
  </div>
  <div class="aov-hero-body">
    {{#if apiMetadata.description}}
    <p class="aov-hero-desc">{{apiMetadata.description}}</p>
    {{/if}}
    {{#if apiMetadata.tags}}
    <div class="dp-tags">
      {{#apiMetadata.tags}}
      <span class="dp-tag dp-tag--white">{{this}}</span>
      {{/apiMetadata.tags}}
    </div>
    {{/if}}
    <div class="aov-hero-actions">
      {{!-- Subscribe opens the plan dialog (plan-picker.js); once subscribed it becomes Switch plan,
            next to View subscription. --}}
      {{#if subscriptionPlans.length}}
        {{#if @root.isAuthenticated}}
          {{#if (or @root.access.subscribe @root.access.checkout)}}
      <button type="button" class="dp-btn dp-btn--primary" data-plan-picker
        data-api-id="{{apiMetadata.id}}" data-org-id="{{@root.orgId}}"
        data-api-name="{{or apiMetadata.title apiMetadata.name}}"
        data-plans="{{jsonAttr (pickerPlans subscriptionPlans)}}"
        data-current="{{currentPlanId subscriptions}}">
            {{#if subscriptions.length}}
        <i class="bi bi-arrow-left-right"></i> Switch plan
            {{else}}
        <i class="bi bi-bookmark-plus"></i> Subscribe
            {{/if}}
      </button>
          {{/if}}
          {{#if subscriptions.length}}
      <button type="button" class="dp-btn dp-btn--outline" data-view-subscription="{{currentPlanId subscriptions}}">
        <i class="bi bi-eye"></i> View subscription
      </button>
          {{/if}}
        {{else}}
      {{!-- Not signed in: Subscribe asks to sign in (disabled in design mode, where login 404s). --}}
      <a class="dp-btn dp-btn--primary{{#if (designMode)}} design-disabled{{/if}}"
        {{#unless (designMode)}}href="{{@root.baseUrl}}/login"{{else}}aria-disabled="true" tabindex="-1" title="Not available in design mode"{{/unless}}>
        <i class="bi bi-bookmark-plus"></i> Subscribe
      </a>
        {{/if}}
      {{/if}}
      {{#in apiMetadata.type values="RestApi,WS,WebSubApi,GRAPHQL,Mcp"}}
      <a class="dp-btn dp-btn--outline" href="{{baseUrl}}/api/{{apiMetadata.id}}/docs/specification">
        <i class="bi bi-book"></i> Documentation
      </a>
      {{else}}
      {{#if schemaUrl}}
      <a class="dp-btn dp-btn--outline" href="{{{schemaUrl}}}" download>
        <i class="bi bi-download"></i> Download
      </a>
      {{/if}}
      {{/in}}
      {{#if aiEnabled}}
      {{#unless (eq apiMetadata.agentVisibility "HIDDEN")}}
      <button type="button" class="dp-btn dp-btn--ai" data-bs-toggle="modal" data-bs-target="#apiAgentPromptModal">
        <i class="bi bi-robot"></i> Try with AI
      </button>
      {{/unless}}
      {{/if}}
      {{#if showApiKeysNav}}
      <a class="dp-btn dp-btn--outline" href="{{baseUrl}}/api/{{apiMetadata.id}}/api-keys">
        <i class="bi bi-key"></i> API Keys
      </a>
      {{/if}}
    </div>
  </div>
</div>
