{{#if subscriptionPlans.length}}
<section id="subscriptionPlans" class="aov-plans-wrap" data-org-id="{{@root.orgId}}"
  data-api-id="{{@root.apiMetadata.id}}" data-api-name="{{or @root.apiMetadata.title @root.apiMetadata.name}}"
  data-api-version="{{@root.apiMetadata.version}}">

  <h2 class="aov-plans-title">Subscription plans</h2>

  {{#each subscriptionPlans}}
  <div class="aov-plan-card subscription-card{{#if (isCurrentPlan id @root.subscriptions)}} aov-plan-card--subscribed{{/if}}"
    id="subscriptionCard-{{id}}"
    data-policy-name="{{id}}"{{#if paid}} data-paid{{/if}}{{#if pricing}} data-billing-period="{{pricing.billingPeriod}}"{{#if pricing.flatAmount}} data-flat-fee{{/if}}{{#if pricing.prices.length}} data-usage-prices="{{pricing.prices.length}}"{{/if}}{{/if}}>
    <div class="aov-plan-ribbon" aria-hidden="true">
      <div class="aov-plan-ribbon-label api-ribbon-label">SUBSCRIBED</div>
    </div>
    <div class="aov-plan-card-head">
      <div class="aov-plan-name-row">
        <span class="aov-plan-icon" style="background:#eef1f5;color:#3a4f6a;">
          <i class="bi bi-lightning-charge-fill"></i>
        </span>
        <span class="aov-plan-name">{{#if displayName}}{{displayName}}{{else}}{{id}}{{/if}}</span>
        {{#if paid}}<span class="aov-plan-badge aov-plan-badge--paid">Paid</span>{{/if}}
      </div>
      {{#unless (isCurrentPlan id @root.subscriptions)}}
      <span class="aov-recommended-badge" style="display:none;">RECOMMENDED</span>
      {{/unless}}
    </div>
    {{#if paid}}
    <div class="aov-plan-price">
      {{#if pricePrefix}}<span class="aov-plan-price-prefix">{{pricePrefix}}</span>{{/if}}
      <span class="aov-plan-price-amount">{{priceAmount}}</span>
      {{#if priceUnit}}<span class="aov-plan-price-unit">{{priceUnit}}</span>{{/if}}
    </div>
    {{#if billingNote}}<div class="aov-plan-billing">{{billingNote}}</div>{{/if}}
    {{#if priceItems.length}}
    {{!-- The prices behind the headline, collapsed; the subscribe dialog lists them from here (api-subscription-plans.js). --}}
    <details class="aov-plan-pricing">
      <summary class="aov-plan-pricing-toggle">Pricing details<i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
      <div class="aov-plan-pricing-body">
        {{#each priceItems}}
        <div class="aov-plan-price-item"{{#if name}} data-name="{{name}}"{{/if}} data-text="{{text}}">
          <div class="aov-plan-price-head">
            {{#if name}}
            <span class="aov-plan-price-name">{{name}}</span>
            <span class="aov-plan-price-text">{{text}}</span>
            {{else}}
            <span class="aov-plan-price-name">{{text}}</span>
            {{/if}}
          </div>
          {{#if tiers}}
          <table class="aov-plan-tier-table">
            <thead><tr>{{#each tiers.headers}}<th scope="col">{{this}}</th>{{/each}}</tr></thead>
            <tbody>
              {{#each tiers.rows}}
              <tr class="aov-plan-tier" data-label="{{label}}" data-amounts="{{amounts}}">{{#each cells}}<td>{{this}}</td>{{/each}}</tr>
              {{/each}}
            </tbody>
          </table>
          {{#if hint}}<p class="aov-plan-price-hint">{{hint}}</p>{{/if}}
          {{/if}}
        </div>
        {{/each}}
      </div>
    </details>
    {{/if}}
    {{else if @root.hasPaidPlans}}
    <div class="aov-plan-price">
      <span class="aov-plan-price-amount">Free</span>
    </div>
    {{/if}}
    <div class="aov-plan-limit">
      {{#if limits.length}}{{#each limits}}
      <span class="aov-plan-count">{{#if (eq limitCount -1)}}∞{{else}}{{limitCount}}{{/if}}</span>
      <span class="aov-plan-unit">{{limitTypeLabel limitType}}{{#if timeUnit}} / {{#unless (eq timeAmount 1)}}{{timeAmount}} {{/unless}}{{timeUnitLabel timeUnit}}{{/if}}</span>
      {{/each}}{{else if requestCount}}
      <span class="aov-plan-count">{{requestCount}}</span>
      <span class="aov-plan-unit">requests / min</span>
      {{else}}
      <span class="aov-plan-unit">Unlimited requests</span>
      {{/if}}
    </div>
    <div class="position-relative">
      {{#if ../isAuthenticated}}
        {{#if (isCurrentPlan id @root.subscriptions)}}
        <button type="button"
          class="dp-btn dp-btn--outline dp-btn--block mcp-view-sub-btn api-view-sub-btn"
          data-org-id="{{@root.orgId}}"
          data-api-id="{{../apiMetadata.id}}"
          data-policy-name="{{id}}"
          data-display-name="{{displayName}}">
          <i class="bi bi-eye"></i> View subscription
        </button>
        {{else}}
        {{#if paid}}
        {{!-- A paid plan is bought through Stripe's checkout, in a dialog (api-subscription-plans.js);
              the button shows only to a user allowed to start one. --}}
        {{#if @root.access.checkout}}
        <button id="subscribe-btn-{{id}}" type="button"
          class="dp-btn dp-btn--outline dp-btn--block paid-subscribe-btn"
          data-api-id="{{../apiMetadata.id}}"
          data-plan-id="{{id}}"
          data-display-name="{{displayName}}"
          ><span class="aov-plan-spinner"></span>Subscribe</button>
        {{/if}}
        {{else if @root.access.subscribe}}
        <button id="subscribe-btn-{{id}}" type="button"
          class="dp-btn dp-btn--outline dp-btn--block subscribe-btn"
          data-org-id="{{@root.orgId}}"
          data-api-id="{{../apiMetadata.id}}"
          data-plan-id="{{id}}"
          data-plan-name="{{id}}"
          data-display-name="{{displayName}}"
          onclick="handlePlanSubscription(this)"
          ><span class="aov-plan-spinner"></span>Subscribe</button>
        {{/if}}
        {{/if}}
      {{else}}
      {{!-- Unauthenticated Subscribe links to login, which 404s in design mode — disable it there. --}}
      <a class="dp-btn dp-btn--outline dp-btn--block{{#if (designMode)}} design-disabled{{/if}}"
        {{#unless (designMode)}}href="{{@root.baseUrl}}/login"{{else}}aria-disabled="true" tabindex="-1" title="Not available in design mode"{{/unless}}>Subscribe</a>
      {{/if}}
    </div>
    <div class="aov-plan-error">
      <i class="bi bi-exclamation-circle-fill" style="color:#c62828;font-size:15px;flex:none;margin-top:1px;"></i>
      <div>
        <div class="aov-plan-error-title">Subscription failed</div>
        <div class="aov-plan-error-desc">We couldn't subscribe you to this plan. Please try again.</div>
      </div>
    </div>
  </div>
  {{/each}}


  <script id="existing-subs-data" type="application/json">{{{json subscriptions}}}</script>
  <script src='{{basePath}}/technical-scripts/api-subscription-plans.js' defer></script>
</section>

{{#if hasPaidPlans}}
<!-- Subscribe to a paid plan -->
<div id="paidSubscribeModal" class="mc-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="paidSubscribeTitle">
  <div class="mc-token-modal">
    <button class="mc-modal-close paid-modal-close" aria-label="Close">&times;</button>
    <div class="mc-token-modal-header" style="text-align:left;">
      <h2 class="mc-token-modal-title" id="paidSubscribeTitle"></h2>
      <p class="mc-token-modal-sub" id="paidSubscribeApi"></p>
    </div>
    <div class="mc-token-modal-body">
      <div class="mc-token-label"><span>Pricing</span></div>
      <table class="aov-usage-pricing-table" style="margin-bottom:12px;">
        <tbody id="paidSubscribePricing"></tbody>
      </table>
      <p class="aov-plans-note" id="paidSubscribeTerms"></p>
      <p class="aov-plans-note">Your subscription becomes active once the payment is confirmed.</p>
      <div class="mc-token-modal-footer" style="display:flex;gap:8px;justify-content:flex-end;">
        <button class="dp-btn dp-btn--outline paid-modal-close">Cancel</button>
        <button id="paidSubscribeContinue" class="dp-btn dp-btn--primary">Continue to payment</button>
      </div>
    </div>
  </div>
</div>

<!-- Payment: Stripe's checkout form, mounted in this dialog by api-subscription-plans.js -->
<div id="checkoutPayModal" class="mc-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="checkoutPayTitle">
  <div class="mc-token-modal checkout-pay-modal">
    <button class="mc-modal-close checkout-pay-close" aria-label="Close">&times;</button>
    <div class="mc-token-modal-header" style="text-align:left;">
      <h2 class="mc-token-modal-title" id="checkoutPayTitle"></h2>
      <p class="mc-token-modal-sub" id="checkoutPayApi"></p>
    </div>
    <div class="checkout-pay-body">
      <div id="checkoutPayLoading" class="checkout-pay-loading" role="status">
        <span class="checkout-pay-spinner" aria-hidden="true"></span>
        <span class="visually-hidden">Loading the payment form</span>
      </div>
      <div id="checkoutPayMount"></div>
    </div>
  </div>
</div>

<!-- Checkout result: activating, failed, or not completed -->
<div id="checkoutStatusModal" class="mc-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="checkoutStatusTitle">
  <div class="mc-token-modal">
    <button class="mc-modal-close checkout-status-close" aria-label="Close">&times;</button>
    <div class="mc-token-modal-header">
      <h2 class="mc-token-modal-title" id="checkoutStatusTitle"></h2>
      <p class="mc-token-modal-sub" id="checkoutStatusText"></p>
    </div>
    <div class="mc-token-modal-body">
      <p class="aov-plans-note" id="checkoutStatusHint"></p>
      <div class="mc-token-modal-footer" style="display:flex;gap:8px;justify-content:flex-end;">
        <button class="dp-btn dp-btn--outline checkout-status-close">Close</button>
        <button id="checkoutStatusRetry" class="dp-btn dp-btn--primary" style="display:none;">Try again</button>
      </div>
    </div>
  </div>
</div>
{{/if}}

<!-- Subscription created token modal -->
<div id="apiTokenModal" class="mc-overlay" style="display:none;" role="dialog" aria-modal="true">
  <div class="mc-token-modal">
    <button id="apiTokenModalClose" class="mc-modal-close" aria-label="Close">&times;</button>
    <div class="mc-token-modal-header">
      <div class="mc-token-success-icon">
        <i class="bi bi-check-lg"></i>
      </div>
      <h2 class="mc-token-modal-title">Subscription created</h2>
      <p class="mc-token-modal-sub">Your subscription to the <strong id="apiTokenPlanName"></strong> plan is now active.</p>
    </div>
    <div class="mc-token-modal-body">
      <div class="mc-token-label">
        <i class="bi bi-key" style="color:#637282;"></i>
        <span>Subscription token</span>
      </div>
      <div class="mc-token-field mc-token-field--pink">
        <div id="apiTokenValue" class="mc-token-val mc-token-val--pink"></div>
        <button id="apiTokenCopyBtn" class="copy-btn mc-token-copy-btn" title="Copy token">
          <span class="copy-btn-icon"><i class="bi bi-copy"></i></span>
          <span class="copy-btn-check"><i class="bi bi-check"></i> Copied</span>
        </button>
      </div>
      <div class="mc-token-warning">
        <i class="bi bi-exclamation-triangle-fill" style="color:#b8860b;flex:none;margin-top:1px;"></i>
        <span>Use this token as the <code class="mc-inline-code">Subscription-Key</code> header when invoking the API.</span>
      </div>
      <div class="mc-token-modal-footer">
        <button id="apiTokenModalDone" class="dp-btn dp-btn--primary">Done</button>
      </div>
    </div>
  </div>
</div>

<!-- Manage subscription modal -->
<div id="apiManageModal" class="mc-overlay" style="display:none;" role="dialog" aria-modal="true">
  <div class="mc-manage-modal">
    <div class="mc-manage-header">
      <div class="mc-manage-header-info">
        <span class="mc-manage-plan-icon"><i class="bi bi-lightning-charge-fill"></i></span>
        <div>
          <h2 id="apiManagePlanName" class="mc-manage-plan-name"></h2>
          <div class="mc-manage-subtitle">API subscription</div>
        </div>
      </div>
      <button id="apiManageClose" class="mc-modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="mc-manage-body">
      <div class="mc-manage-status-row">
        <span class="mc-manage-status-label">Status</span>
        <span id="apiManageStatusBadge" class="mc-manage-status-badge mc-manage-status-badge--active">Active</span>
      </div>
      <div class="mc-token-label" style="margin-top:1.25rem;">
        <i class="bi bi-key" style="color:#637282;"></i>
        <span>Subscription token</span>
      </div>
      <div class="mc-token-field mc-token-field--manage">
        <div id="apiManageTokenVal" class="mc-token-val mc-token-val--manage"></div>
        <div class="mc-token-field-actions">
          <button id="apiManageRevealBtn" class="mc-token-action-btn" title="Reveal token">
            <i id="apiManageRevealIcon" class="bi bi-eye"></i>
          </button>
          <button id="apiManageCopyBtn" class="copy-btn mc-token-copy-btn" title="Copy token">
            <span class="copy-btn-icon"><i class="bi bi-copy"></i></span>
            <span class="copy-btn-check"><i class="bi bi-check"></i> Copied</span>
          </button>
        </div>
      </div>
      <p class="mc-config-note" style="margin:0.625rem 0 0;">Use this token as the <code class="mc-inline-code">Subscription-Key</code> header when calling this API.</p>
      <hr class="mc-manage-divider">
      <div class="mc-manage-actions">
        <button id="apiManageRegenerateBtn" class="dp-btn mc-manage-action-btn mc-manage-action-btn--regenerate">
          <i class="bi bi-arrow-clockwise"></i> Regenerate
        </button>
        <button id="apiManageSuspendBtn" class="dp-btn mc-manage-action-btn mc-manage-action-btn--suspend">
          <i class="bi bi-pause-circle"></i>
          <span class="api-suspend-label">Suspend</span>
        </button>
        <button id="apiManageUnsubBtn" class="dp-btn mc-manage-action-btn mc-manage-action-btn--unsub">
          <i class="bi bi-trash"></i> Unsubscribe
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Unsubscribe / plan-switch dialog -->
<div id="apiUnsubDialog" class="mc-overlay" style="display:none;" role="dialog" aria-modal="true">
  <div class="mc-unsub-dialog">
    <div class="mc-unsub-header">
      <span class="mc-unsub-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
      <h2 id="apiUnsubTitle" class="mc-unsub-title">Unsubscribe from plan?</h2>
    </div>
    <p id="apiUnsubDesc" class="mc-unsub-desc">Your applications will lose access to this API and any tokens will stop working. You can re-subscribe at any time.</p>
    <div class="mc-unsub-actions">
      <button id="apiUnsubKeepBtn" class="dp-btn dp-btn--outline">Cancel</button>
      <button id="apiUnsubConfirmBtn" class="dp-btn mc-unsub-confirm-btn">Unsubscribe</button>
    </div>
  </div>
</div>

<!-- Regenerate token confirmation dialog -->
<div id="apiRegenerateDialog" class="mc-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="apiRegenerateTitle">
  <div class="mc-unsub-dialog">
    <div class="mc-unsub-header">
      <span class="mc-unsub-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
      <h2 class="mc-unsub-title" id="apiRegenerateTitle">Regenerate token?</h2>
    </div>
    <p class="mc-unsub-desc">Your current token will be invalidated immediately. Any applications using it will need to be updated with the new token.</p>
    <div class="mc-unsub-actions">
      <button id="apiRegenerateCancelBtn" class="dp-btn dp-btn--outline">Cancel</button>
      <button id="apiRegenerateConfirmBtn" class="dp-btn mc-unsub-confirm-btn">Regenerate</button>
    </div>
  </div>
</div>
{{/if}}
