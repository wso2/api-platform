{{#pageHead}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
  <link rel="stylesheet" href="/technical-styles/agent-prompt.css">
{{/pageHead}}
{{#pageScripts}}
  <script src="/technical-scripts/oauth2-key-generation.js" defer></script>
  <script src='/technical-scripts/subscription.js' defer></script>
  <script src='/technical-scripts/subscription-modal.js' defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" integrity="sha384-F/bZzf7p3Joyp5psL90p/p89AZJsndkSoGwRpXcZhleCWhd8SnRuoYo4d0yirjJp" crossorigin="anonymous"></script>
  <script src='/technical-scripts/mcp-landing.js' defer></script>
  <script src='/technical-scripts/api-agent-prompt.js' defer></script>
  {{!-- resourcePath drives the .md URL the prompt points at: /mcp/{handle}.md here,
        served by the same loadAPIContentMd handler as the API pages. --}}
  <script type="application/json" id="apiAgentData">{"baseUrl":"{{baseUrl}}","id":"{{apiMetadata.id}}","resourcePath":"mcp"}</script>
{{/pageScripts}}
<div style="padding: 1rem 1.5rem 0;">
  <nav class="dp-breadcrumb">
    <a class="dp-breadcrumb-item" href="{{baseUrl}}/mcps">MCP Servers</a>
    <i class="bi bi-chevron-right dp-breadcrumb-sep"></i>
    <span class="dp-breadcrumb-current">{{or apiMetadata.title apiMetadata.name}}</span>
  </nav>
</div>
<div class="container-fluid">
  {{> mcp-detail-banner }}
</div>
<div class="aov-body">
  <div class="aov-body-main">
    {{#if loadDefault}}
    {{> mcp-default}}
    {{else}}
    {{> mcp-content }}
    {{/if}}
  </div>
  <div class="aov-body-sidebar">
    {{> mcp-config-sidebar}}
  </div>
</div>
{{> alert }}

{{!-- ── AGENT PROMPT MODAL ── --}}
{{#if aiEnabled}}
{{#unless (eq apiMetadata.agentVisibility "HIDDEN")}}
{{> api-agent-prompt-modal}}
{{/unless}}
{{/if}}
