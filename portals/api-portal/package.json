{
  "name": "api-portal-webapp",
  "version": "1.1.0-m6-SNAPSHOT",
  "description": "WSO2 API Platform API Portal",
  "main": "src/server.js",
  "scripts": {
    "start": "NODE_ENV=development nodemon src/server.js --config configs/config.toml",
    "start:local": "APIP_AP_SERVER_HTTPS_ENABLED=false APIP_AP_AUTH_LOCAL_PLATFORM_API_URL=https://localhost:9243 APIP_AP_AUTH_LOCAL_TLS_SKIP_VERIFY=true APIP_AP_AUTH_LOCAL_PUBLIC_KEY_PATH=./resources/keys/jwt_public.pem APIP_AP_DATABASE_PATH=./api-portal.db npm run start",
    "debug": "nodemon --inspect src/server.js --config configs/config.toml",
    "test": "node --test 'src/**/*.test.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wso2/api-platform.git",
    "directory": "portals/api-portal"
  },
  "keywords": [
    "WSO2",
    "API Platform",
    "API Portal"
  ],
  "author": "WSO2 LLC",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "bugs": {
    "url": "https://github.com/wso2/api-platform/issues"
  },
  "homepage": "https://github.com/wso2/api-platform/tree/main/portals/api-portal#readme",
  "dependencies": {
    "async-lock": "1.4.1",
    "axios": "1.20.0",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "express-handlebars": "9.0.5",
    "express-openapi-validator": "5.6.2",
    "express-session": "1.19.0",
    "express-validator": "7.3.2",
    "graphql": "17.0.2",
    "handlebars": "4.7.10",
    "ipaddr.js": "2.4.0",
    "jose": "6.2.3",
    "js-yaml": "5.4.3",
    "marked": "18.0.6",
    "minimatch": "11.0.8",
    "mssql": "12.7.0",
    "multer": "2.5.0",
    "passport": "0.7.0",
    "passport-oauth2": "1.8.0",
    "pg": "8.22.0",
    "smol-toml": "1.9.1",
    "unzipper": "0.12.5",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "overrides": {
    "handlebars": "$handlebars",
    "@apidevtools/json-schema-ref-parser": "15.3.6",
    "minimatch": "11.0.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "15.15.0",
    "nodemon": "3.1.14"
  }
}
