{
  "name": "api-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prestart": "npm run i18n:build",
    "start": "vite --host localhost --port 3000",
    "predev": "npm run i18n:build",
    "dev": "vite --host localhost --port 3000",
    "prebuild": "npm run i18n:build",
    "build": "tsc --noEmit && vite build",
    "prepreview": "npm run i18n:build",
    "preview": "vite preview --host localhost --port 3000",
    "api:codegen": "openapi-typescript ../../platform-api/resources/openapi.yaml -o src/api/generated/platform.d.ts",
    "api:codegen:check": "npm run api:codegen && git add --intent-to-add src/api/generated/platform.d.ts && git diff --exit-code --stat HEAD -- src/api/generated/platform.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "lint:i18n": "eslint . --quiet -c eslint.i18n.config.js",
    "pretest": "npm run i18n:build",
    "test": "vitest run",
    "pretest:watch": "npm run i18n:build",
    "test:watch": "vitest",
    "pretest:coverage": "npm run i18n:build",
    "test:coverage": "vitest run --coverage",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore='**/*.d.ts' --out-file src/i18n/messages/en.json",
    "i18n:compile": "formatjs compile-folder --ast src/i18n/messages src/i18n/compiled",
    "i18n:pseudo": "formatjs compile --ast --pseudo-locale en-XA src/i18n/messages/en.json --out-file src/i18n/compiled/en-XA.json",
    "i18n:build": "npm run i18n:compile && npm run i18n:pseudo",
    "i18n": "npm run i18n:extract && npm run i18n:build",
    "i18n:check": "npm run i18n && git diff --exit-code src/i18n/messages"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "7.29.7",
    "@tanstack/react-query": "5.101.0",
    "@wso2/oxygen-ui": "0.11.0",
    "@wso2/oxygen-ui-icons-react": "0.11.0",
    "axios": "1.19.0",
    "js-yaml": "4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-intl": "^10.1.20",
    "react-router-dom": "7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "9.26.0",
    "@formatjs/cli": "^6.16.18",
    "@openapitools/openapi-generator-cli": "2.5.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.5.2",
    "@types/js-yaml": "4.0.3",
    "@types/node": "20.11.24",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-basic-ssl": "1.1.0",
    "@vitejs/plugin-react": "4.2.1",
    "@vitest/coverage-v8": "2.1.8",
    "babel-plugin-formatjs": "^11.3.16",
    "eslint": "9.26.0",
    "eslint-plugin-formatjs": "^6.4.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "msw": "2.6.8",
    "openapi-typescript": "7.13.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vite": "5.0.11",
    "vitest": "2.1.8"
  }
}
