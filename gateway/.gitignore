# Gateway environment file — contains the control-plane registration token and other secrets
api-platform.env

# AES-256 at-rest encryption key
gateway-controller/aesgcm-keys/
resources/aesgcm-keys/

# Router HTTPS listener certificate/key — generated by scripts/setup.sh (never shipped pre-generated)
gateway-controller/listener-certs/
resources/listener-certs/
