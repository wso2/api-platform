{
  "id": "compat-aliases",
  "displayName": "Compat Provider Aliases",
  "description": "A multi-provider proxy whose additional providers are selected by alias rather than by id.",
  "version": "v1.0",
  "projectId": "project-1",
  "context": "/aliased",
  "vhost": "api.example.com",
  "provider": {
    "id": "openai-provider",
    "auth": {
      "type": "none"
    }
  },
  "additionalProviders": [
    {
      "id": "anthropic-provider",
      "as": "claude",
      "transformer": {
        "type": "openai-to-anthropic",
        "version": "v0"
      }
    },
    {
      "id": "mistral-provider",
      "as": "mistral-eu",
      "transformer": {
        "type": "openai-to-mistral",
        "version": "v0"
      }
    }
  ]
}
