{
  "id": "compat-single",
  "displayName": "Compat Single Provider",
  "description": "A single-provider proxy in the legacy shape, as every proxy in a customer database is today.",
  "version": "v1.0",
  "projectId": "project-1",
  "context": "/single",
  "vhost": "api.example.com",
  "provider": {
    "id": "openai-provider",
    "auth": {
      "type": "api-key",
      "header": "Authorization",
      "value": "{{ secret \"openai-loopback\" }}"
    }
  },
  "globalPolicies": [
    {
      "name": "api-key-auth",
      "version": "v1",
      "params": { "key": "x-api-key", "in": "header" }
    }
  ]
}
