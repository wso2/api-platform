# Platform API coverage image — integration tests only, never released.
#
# The image (./Dockerfile) built around a coverage-instrumented binary, plus a
# writable /coverage folder where the binary writes Go coverage data (GOCOVERDIR is
# set by the image Dockerfile). Build it through docker-bake.hcl, which supplies the
# "image" context (the image target, compiled with ENABLE_COVERAGE=true).

FROM image
USER 0
RUN mkdir -p /coverage && chown 10001:0 /coverage && chmod 775 /coverage
USER wso2
