{{? data.operation['x-basicauth-roles'] && data.operation['x-basicauth-roles'].length}}

Required roles: {{= data.operation['x-basicauth-roles'].map(function(r){return '`'+r+'`';}).join(', ') }}
{{?}}
</aside>
