  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Highest value across the selected time range. Only the request_headers phase is counted, because the later phases would count the same request again. Every MCP call is one HTTP request here, including the initialize handshake each session opens with.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "max"
          ],
          "fields": ""
        },
        "text": {},
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(policy_engine_requests_total{phase=\"request_headers\"}[1m]))",
          "interval": "",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Peak requests / sec",
      "type": "stat"
    },
    {
