{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/chat/completions",
    "bodyPatterns": [
      { "matchesJsonPath": "$.messages[?(@.content =~ /.*FAIL.*/)]" }
    ]
  },
  "response": {
    "status": 500,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "error": {
        "message": "Simulated upstream failure.",
        "type": "server_error"
      }
    }
  }
}
