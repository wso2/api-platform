# Base URL of the evil (WireMock) MCP server. Set by setup.sh's default port;
# override only if you changed EVIL_SERVER_PORT.
EVIL_SERVER_URL=http://localhost:8089/mcp

# --- Fill these in AFTER completing "Prerequisite: configure the gateway" in README.md ---

# Invoke URL of the MCP Proxy in WSO2 API Platform, WITH the MCP Access
# Control policy attached and deployed.
GATEWAY_MCP_URL=

# Optional: subscription key / bearer token required by your gateway deployment.
GATEWAY_API_KEY=
