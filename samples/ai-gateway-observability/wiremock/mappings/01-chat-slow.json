{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/chat/completions",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.messages[0].content",
          "contains": "SLOW"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 1200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": "chatcmpl-mock-slow",
      "object": "chat.completion",
      "created": 1700000000,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "This reply was deliberately delayed so the latency panel has a tail to show."
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 25,
        "completion_tokens": 95,
        "total_tokens": 120
      }
    }
  }
}
