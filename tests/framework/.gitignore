# Coverage artifacts a -coverage run collects and `make coverage-report` renders.
coverage-out/
suites/*-coverage-out/

# Failure evidence (screenshot + DOM) the UI suite drops per failing scenario.
suites/ui/artifacts/

# Local cloud environment-to-domain mapping.
core/catalog/cloudconsole/environments.toml

# Per-runner scenario-sheet results (cmd/sheetreport input).
suites/*/sheet-results/
sheet-report.csv
sheet-report-*.csv
# Embedded copies of gateway files, generated by `make snapshots` and by the release workflow.
# Only snapshots/.gitkeep is committed.
snapshots/*
!snapshots/.gitkeep
